{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/services/:slug", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/projects/:slug", "destination": "/index.html" },
    { "source": "/industries", "destination": "/index.html" },
    { "source": "/mmt", "destination": "/index.html" },
    { "source": "/technical-office", "destination": "/index.html" },
    { "source": "/quality", "destination": "/index.html" },
    { "source": "/careers", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/quote", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
